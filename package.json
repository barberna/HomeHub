{
  "name": "homehub",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:all": "npm run build --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace=client",
    "lint": "npm run lint --workspaces",
    "lint:client": "npm run lint --workspace=client",
    "lint:server": "npm run lint --workspace=server",
    "test": "npm run test --workspace=client --",
    "test:client": "npm run test --workspace=client --",
    "test:server": "npm run test --workspace=server --",
    "test:watch": "npm run test:watch --workspace=client",
    "preview": "npm run preview --workspace=client --"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  }
}
