# Copy to server/.env. Replace every REPLACE_* value before starting the API.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_URL=postgresql://homehub_app:REPLACE_WITH_URL_ENCODED_APP_PASSWORD@127.0.0.1:5432/homehub?schema=public
CLIENT_ORIGIN=http://localhost:5173
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_LONG_RANDOM_AUTH_SECRET
# Generate 32 random bytes encoded as base64url: exactly 43 characters.
SETUP_SECRET=REPLACE_WITH_A_GENERATED_43_CHARACTER_SECRET
# Current email transport uses Gmail. Supply the account and its SMTP/app password.
SMTP_USER=your-account@example.com
SMTP_PASSWORD=REPLACE_WITH_SMTP_CREDENTIAL

